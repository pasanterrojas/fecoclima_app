# En desarrollo puede apuntar directamente al API.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_APP_NAME=FECOCLIMA IA
# Leaflet usa fondos abiertos y no requiere una clave cartográfica.

# Must match CSRF_COOKIE_NAME in the backend.
NUXT_PUBLIC_CSRF_COOKIE_NAME=csrf_token

# Fondo compartido de todos los mapas: eox (actual) o esri.
# Esri requiere una licencia aplicable; no activa una cuenta ni contrata pagos.
NUXT_PUBLIC_SATELLITE_BASEMAP=eox
