# En desarrollo puede apuntar directamente al API.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_APP_NAME=FECOCLIMA IA
# Clave pública MapTiler para mapa mundial y capa satelital. Restrinja por origen.
NUXT_PUBLIC_MAPTILER_KEY=

# Must match CSRF_COOKIE_NAME in the backend.
NUXT_PUBLIC_CSRF_COOKIE_NAME=csrf_token
